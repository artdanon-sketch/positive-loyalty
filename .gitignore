# зависимости
node_modules/
.pnpm-store/

# сборка
dist/
# Мобильные сборки веб-части: dist-owner, dist-cashier, dist-native
dist-*/
build/
.turbo/
.vite/
*.tsbuildinfo

# тесты и отчёты
coverage/
playwright-report/
test-results/

# окружение: в репозитории живёт только .env.example
.env
.env.*
!.env.example
*.local

# деплой
.wrangler/
.railway/

# логи
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# кэш инструментов
.cache/
.eslintcache

# локальная база
prisma/*.db
prisma/*.db-journal

# клиент Prisma: собирается из prisma/schema.prisma на postinstall,
# в репозитории не хранится — иначе каждый pnpm install даёт шумный дифф
apps/api/src/generated/

# ос и редакторы
.DS_Store
Thumbs.db
.idea/

# Снимки состояния базы до и после наката: рабочие файлы, не для репозитория
.schema-snapshot-*.json
