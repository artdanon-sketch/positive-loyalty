# ─────────────────────────────────────────────────────────────────────────────
# POSitive Loyalty — шаблон окружения.
# Скопируй в .env и подставь свои значения: cp .env.example .env
#
# Реальные секреты в репозиторий не попадают никогда.
# Они живут в Railway env, Cloudflare env и Supabase Vault
# (docs/05_Безопасность_и_антифрод.md, раздел 9).
# ─────────────────────────────────────────────────────────────────────────────

# ── API (apps/api) ───────────────────────────────────────────────────────────

# Режим работы: development | test | production
NODE_ENV=development

# Порт HTTP-сервера API. Локально фронты ждут API именно здесь.
PORT=3000

# PostgreSQL. Локально — docker postgres, в облаке — Supabase.
# Формат: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Пример:  postgresql://positive_app:ЗАМЕНИ_МЕНЯ@localhost:5432/positive_loyalty?schema=public
#
# Читают двое: Prisma CLI через prisma.config.ts (migrate, generate, studio)
# и driver adapter @prisma/adapter-pg внутри apps/api. Значения по умолчанию нет
# намеренно — молчаливый фолбэк на localhost однажды закончится миграцией,
# накатанной не на ту базу. Как накатывать — prisma/README.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/positive_loyalty?schema=public

# Схема, в которой живёт система лояльности.
#
# ЗАЧЕМ ОТДЕЛЬНАЯ ПЕРЕМЕННАЯ, А НЕ ?schema= В СТРОКЕ ВЫШЕ. База может быть общей
# с другим продуктом: у нас своя схема, у соседа своя. Схема нужна В ТРЁХ местах —
# миграциям, генерируемым запросам Prisma и сырому SQL, — и все три обязаны брать
# её из ОДНОГО источника. Разъедутся молча: миграции создадут таблицы в одной
# схеме, а приложение будет писать в другую. На общей базе «другая» — это схема
# соседа.
#
# prisma.config.ts сам подставляет это значение в ?schema= при миграциях.
# Задавать его в строке подключения руками не нужно.
#
# public — сегодняшнее поведение для отдельной базы. Для общей базы задайте своё
# имя, например loyalty, и накатите миграции заново.
DATABASE_SCHEMA=public

# Строка подключения ВЛАДЕЛЬЦА базы. Нужна только миграциям.
#
# ЗАЧЕМ ОТДЕЛЬНАЯ СТРОКА. Создавать таблицы, функции и политики умеет только
# владелец. А приложение обязано ходить в базу НЕ владельцем: владелец таблицы
# игнорирует и REVOKE, и политики RLS — под ним изоляция заведений не действует,
# хотя выглядит настроенной.
#
# Поэтому DATABASE_URL выше — это ограниченная роль positive_app, под ней
# работает API. Владелец живёт здесь, и читает его один prisma.config.ts.
#
# Пусто — значит роль одна на всё, и миграции пойдут по DATABASE_URL.
# Так устроены локальная разработка и CI, и это нормально.
# На общей базе с чужим продуктом заполнять обязательно.
#
# Заполняется автоматически:  pnpm setup:supabase
DATABASE_URL_OWNER=

# Корневой сертификат сервера базы, целиком, в формате PEM.
#
# Соединение с облачной базой шифруется ВСЕГДА — это не настраивается.
# Проверено на живой базе: драйвер по умолчанию шифрование не просит,
# а Supabase соединение без него принимает, и ничто об этом не сообщает.
#
# Эта переменная отвечает за другое: проверку, что на том конце действительно
# наша база, а не чужой сервер. Сертификат Supabase подписан их собственным
# центром, которого нет в системном списке доверенных, поэтому без него
# проверить подлинность нечем.
#
# Пусто — шифрование есть, проверки подлинности нет: защищает от подслушивания,
# не защищает от подмены сервера. Скачать сертификат:
# Supabase → Project Settings → Database → SSL Configuration.
DATABASE_SSL_CA=

# ОТДЕЛЬНАЯ база для интеграционных тестов ledger
# (pnpm --filter @positive/api run test:integration).
#
# Почему отдельная, а не «та же, но осторожно»: тесты пишут в LedgerEntry строки,
# которые невозможно удалить — UPDATE, DELETE и TRUNCATE на журнале запрещены
# триггером. Прогон по базе разработки засоряет её навсегда.
#
# Совпадение с DATABASE_URL тесты считают ошибкой конфигурации и отказываются
# стартовать. Переменная нужна только локально: в CI интеграционные тесты не идут.
# Миграции на неё накатываются подменой переменной на один вызов:
#   bash:       DATABASE_URL="$DATABASE_URL_TEST" pnpm db:deploy
#   PowerShell: $env:DATABASE_URL=$env:DATABASE_URL_TEST; pnpm db:deploy
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/positive_loyalty_test?schema=public

# Redis для очередей BullMQ и rate limit. Локально — docker, в облаке — Upstash.
# Для Upstash строка начинается с rediss:// (TLS).
REDIS_URL=redis://localhost:6379

# ── Фронты (apps/admin, apps/guest) ──────────────────────────────────────────
# Vite отдаёт в бандл только переменные с префиксом VITE_.
# Ничего секретного сюда класть нельзя: значение видно в исходниках страницы.

# Базовый URL API вместе с версией пути.
VITE_API_URL=http://localhost:3000/v1

# Секрет подписи access-токенов. Из него берётся tenantId, то есть от него прямо
# зависит изоляция заведений: подобрал секрет — выписал себе токен с чужим tenantId.
# Минимум 32 символа, в production обязателен. Локально сгенерируйте свой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_TOKEN_SECRET=

# Строка подключения под ролью positive_app — той, под которой приложение обязано
# работать в бою. Нужна тестам изоляции: владелец таблицы политики RLS игнорирует,
# и под ним проверка ничего не проверяет. Как завести роль — в prisma/README.md.
DATABASE_URL_TEST_APP_ROLE=postgresql://positive_app:<пароль>@localhost:5432/positive_loyalty_test?schema=public

# ── Способы входа гостя (читает apps/api) ────────────────────────────────────
# Пусто — способ выключен целиком, и кнопка в приложении не показывается.

# Идентификатор приложения в Google. Не секрет: виден в коде страницы.
# Он же нужен фронту как VITE_GOOGLE_CLIENT_ID (см. apps/guest/.env.example).
GOOGLE_CLIENT_ID=

# Ключ бота Telegram от @BotFather. Настоящий секрет: даёт полный доступ к боту.
TELEGRAM_BOT_TOKEN=
