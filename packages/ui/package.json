{
  "name": "@positive/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Дизайн-система POSitive Loyalty: токены и переключение темы",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
