// ─────────────────────────────────────────────────────────────────────────────
// POSitive Loyalty — схема базы данных.
//
// Задача 2 дорожной карты (docs/06, раздел 8): четыре модели ledger-контура —
// Tenant, Guest, Membership, LedgerEntry. Поля взяты дословно из
// docs/01_Архитектура_и_данные.md, разделы 4.1, 4.2, 4.4.
//
// Location, GuestChannel, Consent, Device, Staff, Offer, PosLink, WebhookEvent,
// AuditLog, Broadcast, Certificate, Review появятся в следующих задачах.
// Их связи здесь намеренно вырезаны, а не закомментированы: схема должна
// валидироваться целиком, а не «почти».
//
// Железные правила, которые эта схема обслуживает (CLAUDE.md):
//   • баллы меняются только через LedgerService — таблица LedgerEntry append-only,
//     запрет UPDATE/DELETE прибит в миграции двумя механизмами (см. prisma/README.md);
//   • деньги и баллы — целые в минорных единицах (Int, сатанги и баллы), без float;
//   • каждая финансовая запись несёт idempotencyKey с UNIQUE — повтор ловится базой,
//     а не только приложением;
//   • отмена операции — новая запись REVERSAL со ссылкой reversalOfId,
//     исходная строка не правится никогда.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"

  // apps/api — CommonJS (NestJS 10 держится на legacy-декораторах).
  // Prisma 7 по умолчанию генерирует ESM, поэтому формат задан явно.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7 больше не принимает url в блоке datasource: строка подключения живёт
// в prisma.config.ts (для CLI) и в driver adapter (для рантайма клиента).
datasource db {
  provider = "postgresql"
}

// ─── Перечисления ────────────────────────────────────────────────────────────

enum Vertical {
  RESTAURANT
  SPA
  RENTAL
  RETAIL
  OTHER
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAUSED
  CHURNED
}

enum Plan {
  FREE
  PRO
  NETWORK
}

enum GuestMode {
  TOURIST
  RESIDENT
}

/// Чем гость доказывает, что это он.
///
/// PHONE остаётся: телефон с кодом подтверждения никуда не делся, он просто
/// перестал быть единственным способом. Гость без смартфона или без нужного
/// мессенджера должен иметь возможность войти.
enum IdentityProvider {
  GOOGLE
  LINE
  TELEGRAM
  PHONE
}

enum AcquisitionSource {
  ORGANIC
  CATALOG
  REFERRAL
  STAFF
  IMPORT
}

/// Тип ledger-записи. Знак amount задаётся типом операции, а не полем:
/// EARN/GRANT/ADJUST(+) кладут плюс, REDEEM/EXPIRE — минус,
/// REVERSAL — противоположный знак отменяемой записи.
enum LedgerType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  REVERSAL
  GRANT
}

/// Откуда пришла операция. Нужен антифроду: STAFF_MANUAL и SIGNED_QR
/// имеют принципиально разный уровень доверия.
enum LedgerSource {
  POS_WEBHOOK
  POS_SYNC
  SIGNED_QR
  STAFF_MANUAL
  PAYMENT
  SYSTEM
}

enum ActorType {
  SYSTEM
  STAFF
  OWNER
  GUEST
}

// ─── Модели ──────────────────────────────────────────────────────────────────

/// Мерчант. Корень мультитенантности: всё тенантное ссылается сюда,
/// RLS-политики в Задаче 3 будут сравнивать tenantId с app.tenant_id.
model Tenant {
  id         String       @id @default(uuid())
  brandName  String
  legalName  String?
  vertical   Vertical
  currency   String       @default("THB")
  timezone   String       @default("Asia/Bangkok")
  locale     String       @default("th")
  status     TenantStatus @default(TRIAL)
  plan       Plan         @default(FREE)
  seasonMode Boolean      @default(false) // льготный тариф низкого сезона
  settings   Json // ProgramConfig, docs/01 раздел 4.3
  createdAt  DateTime     @default(now())

  memberships       Membership[]
  ledgerEntries     LedgerEntry[]
  staff             Staff[]
  staffDevices      StaffDevice[]
  sessions          Session[]
  previews          TransactionPreview[]
  posLinks          PosLink[]
  webhookEvents     WebhookEvent[]
  webhookDeliveries WebhookDelivery[]
  partnershipTriggerRuns PartnershipTriggerRun[]
  saleKinds              SaleKind[]
  posQueueItems          PosQueueItem[]
  offers            Offer[]
  offerGrants       OfferGrant[]

  partnershipsInitiated Partnership[] @relation("PartnershipInitiator")
  partnershipsReceived  Partnership[] @relation("PartnershipPartner")
  inviteQuotas          InviteQuota[]
  invitesBlocked        InviteBlock[] @relation("InviteBlocker")
  invitesBlockedBy      InviteBlock[] @relation("InviteBlocked")
}

/// Гость платформы. Один на всю сеть мерчантов: телефон — сквозной идентификатор,
/// участие в конкретной программе описывает Membership.
model Guest {
  id           String    @id @default(uuid())
  /// Телефон. НЕОБЯЗАТЕЛЕН — и это осознанное отступление от docs/01, где он
  /// назван первичным идентификатором.
  ///
  /// ПРИЧИНА. Вход добавлен через Google, LINE и Telegram, а ни один из трёх
  /// не отдаёт номер телефона: Google даёт почту, LINE — свой идентификатор
  /// и иногда почту, Telegram — только свой идентификатор. Требовать номер
  /// после входа через аккаунт значит вернуть ровно то трение, ради устранения
  /// которого вход и добавлялся.
  ///
  /// ЧТО ИЗ ЭТОГО СЛЕДУЕТ. Кассир больше не может найти гостя набором номера —
  /// только по QR-коду из приложения. Решение владельца от 7 сентября 2026:
  /// QR достаточно.
  ///
  /// Уникальность сохранена: в PostgreSQL уникальный индекс допускает сколько
  /// угодно NULL, поэтому «номер не указан» не конфликтует сам с собой,
  /// а два гостя с одним номером по-прежнему невозможны.
  phoneE164    String?   @unique
  displayName  String?
  locale       String    @default("ru") // ru | en | th | zh
  mode         GuestMode @default(TOURIST) // вычисляемое по поведению
  modeLockedBy String? // 'auto' | 'manual'
  birthday     DateTime? // спрашиваем позже, не на входе
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?

  memberships   Membership[]
  guestSessions GuestSession[]
  identities    GuestIdentity[]
  ledgerEntries LedgerEntry[]
  offerGrants   OfferGrant[]
}

/// Участие гостя в программе конкретного тенанта.
///
/// pointsBalance — денормализованный КЭШ. Источник истины — сумма LedgerEntry.amount.
/// Пишется только внутри той же Serializable-транзакции, что и ledger-запись,
/// и только из LedgerService. Ночной джоб reconcile сверяет кэш с суммой.
model Membership {
  id             String            @id @default(uuid())
  guestId        String
  tenantId       String
  pointsBalance  Int               @default(0) // КЭШ. Источник истины — ledger
  stampsCount    Int               @default(0)
  tierId         String? // id статуса из Tenant.settings.tiers, не FK
  firstVisitAt   DateTime?
  lastVisitAt    DateTime?
  visitsTotal    Int               @default(0)
  spentTotal     Int               @default(0) // в минорных единицах (сатанги)
  source         AcquisitionSource @default(ORGANIC)
  referredById   String? // Membership, приведший этого гостя; FK появится вместе с рефералкой
  isControlGroup Boolean           @default(false) // 5% без начислений — доказательство ROI

  guest         Guest                @relation(fields: [guestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ledgerEntries LedgerEntry[]
  previews      TransactionPreview[]

  @@unique([guestId, tenantId])
  // Под политику RLS на Guest: она делает EXISTS по участиям на каждую строку.
  // Индекс создан миграцией 20260826120000_tenant_isolation_rls; объявлен здесь,
  // иначе следующий diff посчитал бы его лишним и удалил — тихая деградация
  // в последовательный скан на каждом чтении гостя.
  @@index([guestId, tenantId])
  @@index([tenantId, lastVisitAt])
}

/// Журнал операций с баллами. Append-only: единственная разрешённая операция — INSERT.
///
/// Запрет UPDATE/DELETE живёт в миграции и продублирован двумя независимыми
/// механизмами (REVOKE + BEFORE-триггер), потому что каждый по отдельности обходится.
/// Подробности — в prisma/README.md и в комментариях migration.sql.
model LedgerEntry {
  id           String @id @default(uuid())
  tenantId     String
  guestId      String
  membershipId String

  type         LedgerType
  amount       Int // ЗНАКОВОЕ: +начисление, −списание. Баллы целые.
  balanceAfter Int // снапшот для быстрых выписок

  basisAmount Int? // сумма чека в минорных единицах (сатанги)
  currency    String @default("THB")

  source  LedgerSource
  refType String? // receipt | offer_grant | referral | promo
  refId   String?

  /// ЧТО именно продали, если заведение ведёт список видов продаж.
  ///
  /// Не то же самое, что refType. refType отвечает «чем эта запись вызвана»
  /// (чек, промокод, реферал); saleKind — «что заведение продало»: абонемент,
  /// разовое занятие, товар. Чек остаётся чеком: отмена, выручка и лента
  /// в зале работают по-прежнему, а вид продажи лежит рядом.
  ///
  /// NULL — обычное дело: список ведут не все, и до его появления не вёл никто.
  saleKindId String?

  /// Ключ идемпотентности. UNIQUE — последний рубеж: даже если приложение
  /// проспит гонку, вторую запись не пустит база.
  idempotencyKey String  @unique
  /// Ссылка на отменяемую запись. UNIQUE — одну операцию нельзя отменить дважды.
  reversalOfId   String? @unique
  offerId        String? // Offer появится в Задаче по акциям, пока не FK

  actorType  ActorType
  actorId    String?
  locationId String? // Location появится позже, пока не FK
  deviceId   String?
  ip         String?

  /// Когда мы об операции УЗНАЛИ.
  createdAt DateTime @default(now())

  /// Когда операция ПРОИЗОШЛА, если это не момент записи. NULL — совпадает.
  ///
  /// Чек от кассы приходит вебхуком, и вебхук опаздывает: связь рвётся, касса
  /// работает офлайн и досылает смену вечером. Без этого поля вечерняя выгрузка
  /// легла бы одним столбцом отчёта, а «загрузка по часам» показала бы девять
  /// вечера вместо обеда — и владелец поставил бы акцию не на тот час.
  ///
  /// Аналитика читает coalesce(occurredAt, createdAt); createdAt при этом
  /// остаётся неизменяемым и отвечает на другой вопрос — когда узнали.
  occurredAt DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  guest      Guest      @relation(fields: [guestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  saleKind   SaleKind?  @relation(fields: [saleKindId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Самоссылка «отмена → исходная операция».
  // Restrict с обеих сторон: SetNull по умолчанию означал бы UPDATE строки ledger,
  // а UPDATE на этой таблице запрещён триггером — FK просто перестал бы работать.
  reversalOf LedgerEntry? @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy LedgerEntry? @relation("LedgerReversal")

  @@index([tenantId, createdAt])
  // Аналитика группирует по времени СОБЫТИЯ, а не записи: без этого индекса
  // дашборд заведения за 90 дней уходит в последовательный скан журнала.
  @@index([tenantId, occurredAt])
  @@index([membershipId, createdAt])
  @@index([guestId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Аутентификация и роли
// docs/05_Безопасность_и_антифрод.md, разделы 2 и 3
// ─────────────────────────────────────────────────────────────────────────────

/// Роли из docs/05, раздел 3. Матрица прав — там же.
enum Role {
  CASHIER
  MANAGER
  OWNER
  /// Отдельный контур: свой поддомен, IP-allowlist, обязательная 2FA.
  PLATFORM_ADMIN
}

/// Сотрудник заведения.
///
/// Владелец входит через OAuth POSitive POS и в этой таблице появляется без PIN.
/// Кассир и менеджер входят по PIN, и ТОЛЬКО с зарегистрированного устройства.
model Staff {
  id       String @id @default(uuid())
  tenantId String
  role     Role   @default(CASHIER)

  displayName String
  /// PII. В логи не попадает, наружу отдаётся маскированным.
  phoneE164   String?

  /// PIN не хранится. Здесь производная scrypt вместе с солью и параметрами.
  /// null у владельца: он входит не по PIN.
  pinHash           String?
  /// Сколько неверных PIN подряд. Сбрасывается успешным входом.
  pinFailedAttempts Int       @default(0)
  /// До какого момента вход заблокирован после серии неудач.
  pinLockedUntil    DateTime?

  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  devices  StaffDevice[]
  sessions Session[]

  @@index([tenantId, role])
}

/// Устройство, с которого сотруднику разрешено входить.
///
/// Регистрирует владелец. Без записи здесь PIN не принимается: иначе кассир
/// заходит с домашнего телефона и начисляет себе ночью (docs/05, раздел 2).
model StaffDevice {
  id       String @id @default(uuid())
  tenantId String
  staffId  String

  /// Отпечаток устройства, приходит от клиента кассы. Уникален глобально:
  /// одно физическое устройство не должно числиться за двумя заведениями.
  deviceId String @unique
  /// Человекочитаемая метка для списка в бэк-офисе: «Планшет у бара».
  label    String

  isActive     Boolean   @default(true)
  registeredAt DateTime  @default(now())
  /// Кто зарегистрировал. Нужен аудиту.
  registeredBy String?
  revokedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, staffId])
}

/// Сессия: одно звено цепочки refresh-токенов.
///
/// Каждое обновление выдаёт новый refresh и инвалидирует старый (ротация).
/// Повторное использование отозванного — сигнал кражи: отзывается ВСЯ цепочка
/// (`familyId`), а не только это звено (docs/05, раздел 2).
model Session {
  id       String @id @default(uuid())
  tenantId String

  /// Кто владеет сессией. Гость появится вместе с OTP-входом.
  staffId String?

  /// Цепочка ротаций. Общий для всех звеньев одного входа.
  familyId String
  /// Предыдущее звено. Позволяет восстановить порядок при разборе инцидента.
  parentId String? @unique

  /// Сам токен не хранится — только SHA-256 от него.
  /// Refresh высокоэнтропийный и случайный, поэтому медленный KDF здесь не нужен:
  /// перебор невозможен, а быстрый хеш не даёт сравнивать за разное время.
  refreshTokenHash String @unique

  /// Привязка к устройству: refresh с чужого устройства не принимается.
  deviceId String?

  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  /// TOKEN_ROTATED | TOKEN_REUSED | LOGOUT | DEVICE_REVOKED | STAFF_DISABLED
  revokedReason String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, familyId])
  @@index([staffId, issuedAt])
}

/// Предрасчёт кассы: что произойдёт, если чек провести.
///
/// ПОЧЕМУ ТАБЛИЦА, А НЕ REDIS. Redis в проекте будет (Upstash, docs/01 раздел 6),
/// но предрасчёт — это финансовое намерение: по нему через минуту спишут баллы.
/// Потеря записи при перезапуске кеша означает «касса нажала подтвердить,
/// а система забыла, что обещала». В Postgres он живёт вместе с журналом,
/// попадает под ту же изоляцию и переживает всё, что переживает журнал.
///
/// Живёт 10 минут (docs/02, раздел 3.3: PREVIEW_EXPIRED). Чистится фоновой
/// задачей, когда появится воркер с очередями.
model TransactionPreview {
  id       String @id @default(uuid())
  tenantId String

  membershipId String
  guestId      String

  /// Сумма чека в минорных единицах.
  amount          Int
  /// Сколько баллов гость просит списать.
  redeemRequested Int @default(0)
  /// Сколько списать можно на самом деле: минимум из запроса, баланса и потолка.
  redeem          Int
  /// Сколько начислится после списания.
  pointsToEarn    Int
  /// К оплате деньгами после списания баллов.
  amountToPay     Int

  /// Баланс на момент расчёта. Расхождение при коммите — BALANCE_CHANGED.
  balanceAtPreview Int

  receiptNumber String?
  locationId    String?
  /// Кто считал. Нужен и аудиту, и будущей награде сотруднику.
  staffId       String?

  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  /// Заполняется при коммите: повторное проведение того же предрасчёта запрещено.
  committedAt DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, expiresAt])
  @@index([membershipId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Интеграция с POSitive POS
// docs/01, раздел 3 · docs/02, раздел 4
// ─────────────────────────────────────────────────────────────────────────────

/// Связь заведения с его же заведением в кассовой системе.
///
/// Заполняется один раз при подключении. Пока POS не умеет отдавать OAuth,
/// связь заводится вручную (docs/01, раздел 3.1) — на схеме это не сказывается.
model PosLink {
  id String @id @default(uuid())

  tenantId String

  /// Идентификатор заведения в POSitive POS. UNIQUE глобально: одно заведение
  /// кассы принадлежит ровно одному заведению лояльности, иначе непонятно,
  /// кому начислять.
  posMerchantId String  @unique
  /// Точка, если их несколько.
  posLocationId String?

  /// Куда слать наши события. NULL — касса их не принимает, и мы не шлём.
  ///
  /// Адрес приходит от кассы при подключении. Пока его нет, исходящие события
  /// просто не создаются: копить недоставляемое в очереди бессмысленно.
  callbackUrl String?

  /// Ключ HMAC для проверки подписи входящих вебхуков.
  ///
  /// Лежит в открытом виде намеренно: им нужно ВЫЧИСЛЯТЬ подпись, а не сверять
  /// хеш, поэтому односторонняя функция здесь не подходит. Шифрование строки
  /// в базе появится вместе с хранилищем ключей; до тех пор доступ к колонке
  /// закрыт теми же политиками RLS, что и всё остальное тенантное.
  webhookSecret String

  isActive  Boolean   @default(true)
  linkedAt  DateTime  @default(now())
  revokedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
}

/// Состояние входящего события.
enum WebhookStatus {
  /// Принято и лежит в очереди. Именно эта строка и есть очередь.
  PENDING
  /// Обработано: баллы начислены либо осознанно не начислены.
  PROCESSED
  /// Обработать не удалось; причина в lastError, разбирает человек.
  FAILED
  /// Событие корректное, но делать по нему нечего — например, чек без гостя.
  SKIPPED
}

/// Входящее событие от кассы. Одновременно журнал приёма и очередь обработки.
///
/// ПОЧЕМУ ЭТО ОЧЕРЕДЬ, А НЕ ЗАПИСЬ РЯДОМ С ОЧЕРЕДЬЮ. ТЗ требует принять
/// событие, ответить за 200 мс и обработать асинхронно. Если писать строку
/// сюда И класть задачу в Redis, появляются два независимых хранилища и две
/// новые поломки: строка без задачи — событие принято и потеряно; задача без
/// строки — дедупликация не сработала и чек начислен дважды. Приём должен быть
/// ОДНОЙ транзакцией, поэтому очередь и журнал — одна таблица.
model WebhookEvent {
  id String @id @default(uuid())

  tenantId String

  /// Откуда пришло. Пока единственный источник — POSitive POS.
  source    String
  /// receipt.closed | receipt.voided
  eventType String

  /// `X-Idempotency-Key` отправителя.
  ///
  /// Уникален В ПРЕДЕЛАХ ЗАВЕДЕНИЯ, а не глобально, — и это отступление
  /// от формулировки docs/01, раздел 9. Глобальный UNIQUE на идентификаторе,
  /// который придумывает чужая сторона, означает: одно заведение может занять
  /// чужой номер чека и заблокировать соседу приём. Номера чеков у разных касс
  /// совпадают сплошь и рядом.
  externalId String

  /// Тело события целиком. Нужно для разбора инцидентов и повторной обработки.
  payload Json

  status    WebhookStatus @default(PENDING)
  attempts  Int           @default(0)
  /// Причина последней неудачи. PII сюда не пишется.
  lastError String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, externalId])
  @@index([tenantId, receivedAt])
  /// Под выборку необработанных: восстановление после падения идёт по ней.
  @@index([status, receivedAt])
}

/// Состояние исходящей доставки.
enum DeliveryStatus {
  /// Ждёт отправки или следующей попытки.
  PENDING
  /// Касса ответила 2xx.
  DELIVERED
  /// Попытки исчерпаны. Разбирает человек.
  FAILED
}

/// Исходящее событие к кассе. Исходящий журнал (outbox).
///
/// СОБЫТИЕ ВЫВОДИТСЯ ИЗ ЖУРНАЛА, А НЕ ПИШЕТСЯ РЯДОМ С НИМ. Это главное решение
/// таблицы, и оно не про удобство.
///
/// Очевидный ход — писать строку сюда в той же транзакции, что и операцию.
/// Он даёт нужную гарантию, но требует, чтобы `LedgerService` знал про кассу:
/// где взять адрес, какой ключ, слать ли вообще. Ядро начало бы зависеть
/// от прикладного модуля, а такую зависимость потом не разорвать.
///
/// Journal уже append-only и долговечен. Поэтому разгребатель сам находит
/// операции, о которых касса ещё не знает, и заводит им доставку. Гарантия
/// ровно та же — операция есть, значит и событие о ней появится, — а ядро
/// не трогается вовсе. Цена: событие уходит не мгновенно, а в ближайший
/// проход. Для «касса показывает свежий баланс» это приемлемо.
///
/// Событие может уйти дважды, и это нормально: `eventId` в теле нужен затем,
/// чтобы касса дедуплицировала у себя. «Ровно один раз» через сеть
/// не гарантируется в принципе.
model WebhookDelivery {
  id String @id @default(uuid())

  tenantId String

  /// Операция журнала, о которой сообщаем.
  ///
  /// UNIQUE — здесь работает вместо ключа идемпотентности: два прохода
  /// разгребателя, столкнувшись на одной операции, не заведут две доставки.
  /// Вторая вставка упрётся в базу, а не в удачу.
  ledgerEntryId String @unique

  /// guest.balance_changed | offer.granted
  eventType String
  /// Тело события целиком, уже готовое к отправке.
  payload   Json

  /// Куда слали. Снимок на момент постановки: адрес мог смениться, а событие
  /// принадлежит тому подключению, при котором возникло.
  targetUrl String

  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  /// Когда пробовать следующий раз. Пауза растёт: 1с, 5с, 30с, 5м, 30м.
  nextAttemptAt DateTime       @default(now())
  /// Причина последней неудачи. PII сюда не пишется.
  lastError     String?

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Под выборку «что пора отправить».
  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Гостевой доступ: OTP и сессии гостя
// docs/02, разделы 1.1–1.2 · docs/05, раздел 2
//
// Обе таблицы ГЛОБАЛЬНЫЕ — без tenantId, как и сам Guest: гость один на весь
// остров, его вход не принадлежит заведению. Изоляция здесь другая, чем у
// тенантных таблиц: строки адресуются только секретом (хеш кода, хеш refresh),
// знание которого само по себе и есть право доступа. Подробности — в миграции.
// ─────────────────────────────────────────────────────────────────────────────

/// Запрос кода подтверждения.
model OtpRequest {
  id String @id @default(uuid())

  /// PII. В логи не попадает, маскируется на выводе.
  phoneE164 String

  /// Сам код не хранится — только производная scrypt с солью.
  codeHash String

  /// Куда ушёл код. Пока единственный канал DEV: без SMS-провайдера код
  /// печатается в лог сервера (и отдаётся в ответе вне production).
  channel String @default("DEV")

  /// Неверные попытки. После пятой запрос блокируется (docs/02, раздел 1.2).
  attempts Int @default(0)

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  verifiedAt DateTime?

  @@index([phoneE164, createdAt])
}

/// Через что гость входит: Google, LINE, Telegram.
///
/// ПОЧЕМУ ОТДЕЛЬНАЯ ТАБЛИЦА, А НЕ ПОЛЯ В Guest. У одного человека этих
/// аккаунтов может быть несколько, и добавляются они по одному: сегодня зашёл
/// через Google, через месяц привязал Telegram. Колонки под каждого поставщика
/// означали бы правку схемы на каждый новый способ входа.
///
/// ПОЧЕМУ НЕ GuestChannel ИЗ docs/01. Тот про доставку сообщений — куда писать
/// гостю. Здесь про вход — чем он доказывает, что это он. Совпадают они лишь
/// частично: у Google нет канала доставки, у Wallet нет входа. Смешать их
/// значило бы получить таблицу, где половина строк не имеет смысла.
model GuestIdentity {
  id      String @id @default(uuid())
  guestId String

  provider   IdentityProvider
  /// Идентификатор у поставщика: `sub` у Google, `userId` у LINE, числовой id
  /// у Telegram. Секретом не является — это открытый идентификатор аккаунта.
  externalId String

  /// Почта от поставщика, если он её отдал. Нужна ровно для одного: склеить
  /// карты, когда один человек вошёл сначала через Google, потом через LINE.
  /// У Telegram почты нет — там склейка только вручную, кнопкой в приложении.
  email String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Один аккаунт поставщика принадлежит ровно одному гостю. Без этого два
  /// входа подряд заводили бы двух гостей с одной и той же учётной записью.
  @@unique([provider, externalId])
  @@index([guestId])
  @@index([email])
}

/// Сессия гостя: звено цепочки refresh-токенов. Устройство ротации то же,
/// что у сотрудников (Session): повтор отозванного звена гасит всю цепочку.
model GuestSession {
  id      String @id @default(uuid())
  guestId String

  familyId String
  parentId String? @unique

  /// Хеш refresh-токена. Быстрый SHA-256: токен высокоэнтропийный, KDF не нужен.
  refreshTokenHash String @unique

  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  revokedReason String?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([guestId, familyId])
}

/// Начатый, но ещё не завершённый вход через Telegram.
///
/// ЗАЧЕМ ОТДЕЛЬНАЯ ТАБЛИЦА. Обмен здесь трёхсторонний и растянут во времени:
/// приложение начинает вход, гость подтверждает его В ДРУГОМ МЕСТЕ — в Telegram,
/// с другого устройства и, возможно, через минуту, — а результат забирает опять
/// приложение. Между этими тремя шагами состояние обязано где-то жить, и жить
/// оно должно в базе: держать его в памяти процесса значит потерять все
/// начатые входы при первом же перезапуске сервера.
///
/// Ближайший родственник — OtpRequest: тоже одноразовый пропуск с коротким
/// сроком, тоже хранится хешем, тоже забирается ровно один раз.
model TelegramLoginRequest {
  id String @id @default(uuid())

  /// Хеш одноразового кода, который уходит в ссылку на бота.
  ///
  /// Сам код не хранится: это пароль на вход, и в базе ему место только
  /// в виде хеша. SHA-256 без соли здесь достаточно — код высокоэнтропийный,
  /// перебирать нечего (та же логика, что у refreshTokenHash выше).
  nonceHash String @unique

  /// Хеш секрета, которым приложение доказывает, что вход начало именно оно.
  claimSecretHash String

  /// Кто подтвердил вход. Заполняется ботом, до этого null.
  telegramUserId String?
  /// Имя из профиля Telegram — только чтобы гостю было к чему обращаться.
  displayName    String?
  /// Язык интерфейса Telegram, приведённый к четырём языкам продукта.
  /// Нужен один раз — при заведении новой карты, чтобы гость сразу увидел
  /// приложение на своём языке, а не на русском по умолчанию.
  locale         String?

  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  /// Когда гость нажал «Запустить» в боте.
  confirmedAt DateTime?
  /// Когда приложение забрало сессию. Второй раз забрать нельзя.
  claimedAt   DateTime?

  @@index([expiresAt])
}

/// Кто совершил действие, попавшее в аудит.
///
/// Повторяет Role и добавляет двух субъектов, которых в Role нет: SYSTEM для
/// фоновых заданий и GUEST для действий самого гостя. Отдельное перечисление,
/// а не общий ActorType: в ActorType нет PLATFORM_ADMIN и не должно быть —
/// он живёт в LedgerEntry, где админу платформы делать нечего по матрице
/// docs/05, раздел 3.
enum AuditActorType {
  SYSTEM
  GUEST
  CASHIER
  MANAGER
  OWNER
  PLATFORM_ADMIN
}

/// След действий, которые docs/05 раздел 9 требует хранить 24 месяца.
///
/// ПРАВА НАОБОРОТ ОБЫЧНОГО: приложению выдан только INSERT. SELECT и UPDATE
/// отобраны миграцией, DELETE не выдавался. Поэтому писать сюда через Prisma
/// create() НЕЛЬЗЯ — он делает RETURNING, то есть читает строку обратно.
/// Запись идёт через $executeRaw, см. AuditService.
///
/// Читать журнал будет админка платформы своей ролью Postgres — отдельной
/// миграцией. Ошибка в обычном API не должна уметь выгрузить наблюдения.
model AuditLog {
  id         String   @id @default(uuid())
  occurredAt DateTime @default(now())

  /// NULL — действие вне заведения: вход админа платформы, правка общего прайсинга.
  tenantId String?

  actorType AuditActorType
  actorId   String?

  /// Машиночитаемо: IMPERSONATE_START, PHONE_REVEALED, BALANCE_ADJUSTED.
  action String

  entityType String?
  entityId   String?

  /// Форма зависит от действия — общая колонка под все случаи не описала бы ни один.
  oldValue Json?
  newValue Json?

  /// Для impersonate обязательна (docs/02, раздел 6). Проверяется в коде:
  /// обязательность зависит от action, а не от таблицы.
  reason String?

  ip        String?
  userAgent String?
  requestId String?

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorType, actorId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
}

// ─── Админка платформы: вход ─────────────────────────────────────────────────
//
// Отдельный контур, а не роль внутри Staff. Причина не в удобстве: Staff.tenantId
// обязателен и является внешним ключом на Tenant, то есть сотрудник без заведения
// в этой схеме невыразим. Админ платформы именно таков — он над всеми заведениями,
// а не внутри одного.
//
// Права на эти четыре таблицы у positive_app ОТОБРАНЫ целиком (миграция
// 20260909170000). Основное приложение, обслуживающее владельцев и кассиров,
// не должно иметь возможности прочитать даже хеш пароля админа платформы,
// не говоря о секрете второго фактора.

/// Владелец платформы. Их единицы, и каждый видит данные всех заведений.
model PlatformAdmin {
  id          String @id @default(uuid())
  email       String @unique
  displayName String

  /// scrypt в том же формате, что PIN сотрудника (apps/api/src/auth/pin.ts).
  passwordHash String

  /// Секрет TOTP, зашифрованный AES-256-GCM ключом из окружения.
  /// Компрометация одной только базы не должна давать возможность
  /// генерировать коды второго фактора.
  totpSecretEnc String?

  /// Пока null — второй фактор заведён, но ещё не подтверждён первым кодом.
  /// Вход при этом запрещён: наполовину настроенная 2FA хуже отсутствующей.
  totpConfirmedAt DateTime?

  /// docs/05, раздел 2: прогрессивные задержки и блокировка после 10 попыток.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  /// Номер последнего ПРИНЯТОГО окна TOTP.
  ///
  /// RFC 6238, раздел 5.2 требует прямо: удачно проверенный код не принимается
  /// второй раз. Без этого подсмотренный код живёт все 30 секунд своего окна,
  /// а с допуском на расхождение часов — до полутора минут.
  ///
  /// Хранится номер окна, а не сам код: сравнение «пришедшее окно должно быть
  /// строго больше принятого» отсекает и повтор, и попытку отмотать время назад.
  lastTotpCounter BigInt?

  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  devices       PlatformAdminDevice[]
  sessions      PlatformSession[]
  recoveryCodes PlatformRecoveryCode[]
}

/// Доверенное устройство.
///
/// Взяло на себя роль IP-allowlist, отменённого 9 сентября 2026 (docs/05,
/// раздел 2). Список адресов и вход с телефона несовместимы, а привязка
/// к устройству работает одинаково и на мобильном интернете, и дома.
model PlatformAdminDevice {
  id      String @id @default(uuid())
  adminId String

  /// Хеш идентификатора, а не сам идентификатор: украденная база не должна
  /// давать готовое значение, которым можно притвориться доверенным устройством.
  deviceIdHash String @unique

  /// Человекочитаемо: «iPhone Артёма», чтобы отзывать осознанно.
  label String

  approvedAt DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([adminId, revokedAt])
}

/// Код восстановления на случай потерянного телефона.
///
/// Одноразовые: использованный помечается и больше не принимается. Хранятся
/// хешами — распечатанный список у владельца, в базе только отпечатки.
model PlatformRecoveryCode {
  id       String @id @default(uuid())
  adminId  String
  codeHash String @unique

  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([adminId, usedAt])
}

/// Сессия админа платформы.
///
/// Отдельно от Session по той же причине, что и сам админ отдельно от Staff:
/// Session.tenantId обязателен и ссылается на Tenant.
model PlatformSession {
  id      String @id @default(uuid())
  adminId String

  /// Хеш refresh-токена. Ротация с обнаружением повтора — как у сотрудников.
  refreshTokenHash String @unique

  /// Цепочка ротаций: повторное использование отозванного гасит всю семью.
  familyId String

  /// Устройство, с которого выдана сессия. Хеш, не идентификатор.
  deviceIdHash String?

  ip        String?
  userAgent String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([adminId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

// ─── Акции и промокоды ───────────────────────────────────────────────────────
//
// docs/01, раздел 4.5. Основная механика лояльности после баллов — и то, на чём
// стоят партнёрства: PartnershipTerm при активации порождает Offer, а выдача
// и погашение идут через этот же конвейер (CLAUDE.md, железное правило 6).

/// Вид акции. Список из docs/01, раздел 4.5 — дословно, чтобы не разошёлся.
enum OfferType {
  CASHBACK
  PROMO_ON_CHECK
  FLASH_1DAY
  TIME_WINDOW
  STAMP_CARD
  NETWORK_VOUCHER
  REFERRAL
  BIRTHDAY
  WINBACK
  PACKAGE
  GIFT_CARD
  /// Подарок от заведения гостю из карточки: одна акция на один подарок,
  /// причина обязательна и пишется в аудит (docs/02, раздел 5.2.1).
  GOODWILL
}

enum OfferStatus {
  DRAFT
  SCHEDULED
  LIVE
  PAUSED
  ENDED
}

/// Кому акция видна.
///
/// PARTNER заведён сразу, хотя партнёрств ещё нет: docs/07 добавляет именно это
/// значение, и вводить его отдельной миграцией по перечислению — лишний риск
/// на ровном месте. Пустое значение перечисления никому не мешает.
enum Visibility {
  VENUE_ONLY
  NETWORK
  PARTNER
}

enum GrantState {
  ISSUED
  REDEEMED
  EXPIRED
  VOID
}

/// Акция заведения.
model Offer {
  id       String @id @default(uuid())
  tenantId String

  type   OfferType
  status OfferStatus @default(DRAFT)

  /// Порядок применения в движке правил: меньше — раньше.
  priority  Int     @default(100)
  /// Можно ли складывать с другими. Нестекируемая обрывает цепочку.
  stackable Boolean @default(false)

  /// ALL | TOURIST | RESIDENT | NEW | SLEEPING | segmentId — docs/01, раздел 4.5.
  audience Json
  /// {startsAt, endsAt, weekdays[], timeWindow{from,to}}
  schedule Json
  /// {totalQty, perGuestQty, minCheck, maxDiscount} — суммы в минорных единицах.
  limits   Json
  /// {kind, value} — что именно получает гость.
  reward   Json

  visibility Visibility @default(VENUE_ONLY)

  /// {ru:{title,desc}, en:{...}, th:{...}, zh:{...}} — строки в данных, не в коде.
  i18n Json

  createdAt DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grants          OfferGrant[]
  partnershipTerm PartnershipTerm?

  @@index([tenantId, status])
}

/// Выданный гостю промокод.
model OfferGrant {
  id      String @id @default(uuid())
  offerId String

  /// НЕТ В НАБРОСКЕ ТЗ, И ДОБАВЛЕНО ОСОЗНАННО.
  ///
  /// Без него RLS на этой таблице пришлось бы писать подзапросом к Offer —
  /// а все остальные политики в базе сравнивают колонку напрямую. Разнобой
  /// в способе изоляции опаснее одной денормализованной колонки: именно такие
  /// исключения потом и протекают.
  ///
  /// Плюс сам ТЗ требует при погашении проверить, что «тенант совпадает»
  /// (docs/02, раздел 3.4) — то есть грант обязан знать своё заведение.
  tenantId String

  guestId String

  /// Не меньше восьми символов, криптостойкий (docs/01, раздел 4.5).
  code String @unique

  state GrantState @default(ISSUED)

  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  redeemedAt DateTime?
  /// Кто погасил: сотрудник на кассе.
  redeemedBy String?

  /// Чек, в котором код погасили. ОН ЖЕ КЛЮЧ ИДЕМПОТЕНТНОСТИ погашения.
  ///
  /// Железное правило 3 требует, чтобы повтор финансовой мутации возвращал
  /// ПЕРВЫЙ ответ, а не ошибку. Без этой колонки касса, потерявшая связь уже
  /// после успешного погашения, при повторе получала бы «код уже погашен» —
  /// и кассир решил бы, что операция не прошла, и подарок гостю не отдал.
  ///
  /// NULL у кодов, погашенных до появления колонки, и у тех, кого погасили
  /// без номера чека.
  redeemedReceiptId String?

  /// Одноразовость на уровне базы, отдельно от кода: код показывают гостю,
  /// nonce не показывают никому.
  nonce String @unique

  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([guestId, state])
  @@index([offerId, state])
  @@index([tenantId, state])
  @@index([expiresAt])
}

// ─── Партнёрства между заведениями ───────────────────────────────────────────
//
// docs/07. Два заведения договариваются напрямую и дают бонусы гостям друг
// друга. Платформа в договорённости не участвует и денег между ними не гоняет
// никогда — иначе это расчёты и регуляторный риск.
//
// ИЗОЛЯЦИЯ ЗДЕСЬ УСТРОЕНА ИНАЧЕ, ЧЕМ ВЕЗДЕ. У всех прежних таблиц один хозяин,
// и политика сравнивает одну колонку. У партнёрства хозяев ДВА, и обе стороны
// обязаны видеть строку. Значит политика проверяет ДВЕ колонки через ИЛИ —
// и это единственное место в базе, где так. Ошибиться тут легко: забыть вторую
// половину условия означает, что партнёр не видит собственного партнёрства.

enum PartnershipStatus {
  PROPOSED
  NEGOTIATING
  ACTIVE
  PAUSED
  ENDED
  DECLINED
}

enum TermStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  ACTIVE
  PAUSED
  ENDED
}

enum MessageKind {
  INVITE
  TEXT
  TERM_PROPOSED
  TERM_ACCEPTED
  TERM_REJECTED
  SYSTEM
}

/// Связь двух заведений: контейнер для условий и переписки.
model Partnership {
  id                String @id @default(uuid())
  initiatorTenantId String
  partnerTenantId   String

  status PartnershipStatus @default(PROPOSED)

  proposedAt DateTime  @default(now())
  acceptedAt DateTime?
  /// null — бессрочно.
  endsAt     DateTime?
  endedBy    String?
  endReason  String?
  /// Когда получатель отказал. Пригласить снова то же заведение можно
  /// не раньше чем через 30 дней после этого (docs/07, раздел 6.2).
  declinedAt DateTime?

  initiator Tenant @relation("PartnershipInitiator", fields: [initiatorTenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  partner   Tenant @relation("PartnershipPartner", fields: [partnerTenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  terms    PartnershipTerm[]
  messages PartnershipMessage[]

  /// Одна пара — одно партнёрство (docs/07, раздел 6.2: нельзя долбить одно заведение).
  @@unique([initiatorTenantId, partnerTenantId])
  @@index([partnerTenantId, status])
  @@index([initiatorTenantId, status])
}

/// Одностороннее обязательство: «B даёт награду X гостям A при событии Y».
///
/// Направление всегда явное. Встречное условие — другое Term с обратными
/// ролями. Партнёрство может быть и односторонним.
model PartnershipTerm {
  id            String @id @default(uuid())
  partnershipId String

  /// Где происходит событие.
  triggerTenantId String
  /// Кто даёт награду — и у кого появится Offer.
  rewardTenantId  String

  /// Порождённый Offer у rewardTenant. Появляется при активации, не раньше:
  /// до согласия обеих сторон акции быть не должно.
  offerId String? @unique

  /// Что должно произойти. Форма — docs/07, раздел 4.1.
  trigger Json
  /// Что гость получит. Форма — docs/07, раздел 4.2.
  reward  Json

  /// Сколько живёт выданный промокод.
  validityDays Int  @default(7)
  /// {totalGrants, perGuest, dailyCap}
  limits       Json

  status TermStatus @default(DRAFT)

  /// Кто предложил и кто принял — tenantId, а не сотрудник: договариваются заведения.
  proposedBy String
  acceptedBy String?
  acceptedAt DateTime?
  /// Кто поставил условие на паузу. Снять паузу может только он: согласие
  /// одной стороны не отменяется решением другой.
  pausedBy   String?

  grantsIssued   Int @default(0)
  grantsRedeemed Int @default(0)

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  offer       Offer?      @relation(fields: [offerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([triggerTenantId, status])
  @@index([rewardTenantId, status])
  @@index([partnershipId])
}

/// Вид продажи: что именно заведение продало гостю.
///
/// ЗАЧЕМ ОТДЕЛЬНАЯ СУЩНОСТЬ. Партнёрство «купил абонемент — получи ролл
/// в подарок» невозможно построить на одной сумме: ужин на 5 000 ฿ и абонемент
/// на 5 000 ฿ для журнала неотличимы, и ресторан-донор раздавал бы подарки
/// за крупные счета, которых не ждал.
///
/// СПИСОК ВЕДЁТ САМО ЗАВЕДЕНИЕ, а не платформа. У студии танцев это «абонемент
/// на 10 занятий» и «разовое занятие», у проката — «сутки» и «неделя».
/// Общий справочник на всех означал бы, что каждый новый вид бизнеса ждёт
/// нашего релиза, чтобы начать работать.
///
/// НЕ ЗАВИСИТ ОТ КАССЫ. Вид выбирает кассир, когда проводит начисление в нашем
/// приложении. Партнёру не нужен POSitive POS: у него своя касса для денег,
/// наше приложение — для лояльности.
model SaleKind {
  id       String @id @default(uuid())
  tenantId String

  /// Как это называет само заведение. Видит кассир в списке и партнёр
  /// в условиях договорённости.
  name String

  /// Порядок в списке у кассира: часто продаваемое — наверх.
  sortOrder Int @default(0)

  /// Выключенный вид не предлагается кассиру, но остаётся в журнале.
  /// Удаления нет вовсе: по журналу с исчезнувшими видами продаж
  /// нельзя разобрать ни отчёт, ни спор.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ledgerEntries LedgerEntry[]

  /// Два одинаковых названия в одном заведении — верный способ выбрать не то.
  @@unique([tenantId, name])
  @@index([tenantId, isActive, sortOrder])
}

/// Отметка: эта операция журнала уже разобрана на партнёрские условия.
///
/// СОБЫТИЕ ВЫВОДИТСЯ ИЗ ЖУРНАЛА, А НЕ ПИШЕТСЯ РЯДОМ С НИМ — тем же способом,
/// что и исходящие к кассе (WebhookDelivery). Разгребатель сам находит
/// операции, которых ещё не видел, а ядро про партнёрства не знает вовсе.
///
/// Отметка ставится ПОСЛЕ выдачи наград, а не до. Падение между выдачей
/// и отметкой приводит к повторному разбору — а он безвреден: промокод
/// выдаётся по ключу идемпотентности и второй раз не родится. Обратный
/// порядок терял бы награду молча, и узнать об этом было бы неоткуда.
model PartnershipTriggerRun {
  id String @id @default(uuid())

  /// Заведение-источник: у него произошло событие.
  tenantId String

  /// Разобранная операция. UNIQUE работает и маркером, и защитой от гонки:
  /// два прохода, столкнувшись на одной операции, не разберут её дважды.
  ledgerEntryId String @unique

  /// Сколько наград родилось. Ноль — обычное дело: условия могли не совпасть.
  grantsIssued Int @default(0)

  processedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, processedAt])
}

/// Сообщение в переписке двух заведений.
model PartnershipMessage {
  id            String @id @default(uuid())
  partnershipId String

  fromTenantId String
  /// ЕСТЬ, ХОТЯ В НАБРОСКЕ ТЗ ЕГО НЕТ.
  ///
  /// Без получателя политику RLS пришлось бы писать подзапросом к Partnership —
  /// а адресат сообщения и так нужен: по нему считаются непрочитанные и шлются
  /// уведомления. Поле не служебное, оно по существу.
  toTenantId   String

  kind         MessageKind
  /// Оригинал, как написал отправитель.
  text         String
  /// Язык оригинала — по нему решают, нужен ли перевод.
  sourceLang   String
  /// {"th": "...", "en": "..."} — кэш перевода, чтобы не платить за него дважды.
  translations Json

  termId String?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([partnershipId, createdAt])
  @@index([toTenantId, readAt])
}

/// Сколько приглашений заведение отправило за сутки.
///
/// Сутки — по таймзоне ЗАВЕДЕНИЯ, а не сервера: владелец на Пхукете не должен
/// обнаруживать, что его квота обнулилась в семь вечера.
model InviteQuota {
  tenantId String
  /// Дата в таймзоне заведения.
  date     DateTime @db.Date
  freeUsed Int      @default(0)
  paidUsed Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, date])
}

/// Заведение навсегда закрылось от приглашений другого.
model InviteBlock {
  blockerTenantId String
  blockedTenantId String
  reason          String?
  createdAt       DateTime @default(now())

  blocker Tenant @relation("InviteBlocker", fields: [blockerTenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  blocked Tenant @relation("InviteBlocked", fields: [blockedTenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([blockerTenantId, blockedTenantId])
  @@index([blockedTenantId])
}

/// Квоты и цены приглашений. Настраивает админ платформы.
model PartnershipPricing {
  id String @id @default(uuid())

  /// null — умолчание для всех вертикалей.
  vertical Vertical?

  freeInvitesPerDay     Int @default(3)
  /// В минорных единицах (сатангах). 0 — сверх квоты бесплатно.
  extraInvitePrice      Int @default(0)
  /// Гость не должен утонуть в чужих ваучерах.
  maxActivePartnerships Int @default(20)

  /// Умолчание в базе намеренно: @updatedAt у Prisma работает только на стороне
  /// клиента, и запись сырым SQL — из миграции, seed или скрипта — падала бы
  /// на not-null. Поймано красным CI, а не рассуждением.
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([vertical])
}

/// Чек из очереди планшета кассы, который ещё не дошёл. docs/10, раздел 5.7.
///
/// ЭТО СНИМОК, А НЕ ВТОРАЯ ОЧЕРЕДЬ. Планшет присылает, что у него лежит, и сервер
/// по этим строкам ничего не проводит: проведёт планшет тем же ключом
/// идемпотентности, когда появится связь.
model PosQueueItem {
  id            String    @id @default(uuid())
  tenantId      String
  /// Случайная метка браузера планшета: какой именно это планшет.
  terminalId    String
  /// Кто был в смене, когда планшет прислал снимок.
  staffId       String?
  /// Ключ идемпотентности чека — тот же, с которым он уйдёт на сервер.
  receiptId     String
  /// Сумма чека в сатангах.
  amount        Int
  receiptNumber String?
  /// Участник, если гостя успели найти до обрыва связи. Не FK: пришёл с планшета.
  membershipId  String?
  /// Маска телефона, если гостя искали по номеру. Полного номера здесь нет.
  guestHint     String?
  attempts      Int
  lastError     String?
  queuedAt      DateTime
  /// Когда планшет последний раз прислал снимок с этим чеком.
  reportedAt    DateTime  @default(now())
  /// Чек ушёл из очереди планшета — доехал или снят. Строка не удаляется.
  clearedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, receiptId])
  @@index([tenantId, clearedAt, queuedAt])
  @@index([tenantId, terminalId])
}
