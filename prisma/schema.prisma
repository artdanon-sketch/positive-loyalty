// ─────────────────────────────────────────────────────────────────────────────
// POSitive Loyalty — схема базы данных.
//
// Задача 2 дорожной карты (docs/06, раздел 8): четыре модели ledger-контура —
// Tenant, Guest, Membership, LedgerEntry. Поля взяты дословно из
// docs/01_Архитектура_и_данные.md, разделы 4.1, 4.2, 4.4.
//
// Location, GuestChannel, Consent, Device, Staff, Offer, PosLink, WebhookEvent,
// AuditLog, Broadcast, Certificate, Review появятся в следующих задачах.
// Их связи здесь намеренно вырезаны, а не закомментированы: схема должна
// валидироваться целиком, а не «почти».
//
// Железные правила, которые эта схема обслуживает (CLAUDE.md):
//   • баллы меняются только через LedgerService — таблица LedgerEntry append-only,
//     запрет UPDATE/DELETE прибит в миграции двумя механизмами (см. prisma/README.md);
//   • деньги и баллы — целые в минорных единицах (Int, сатанги и баллы), без float;
//   • каждая финансовая запись несёт idempotencyKey с UNIQUE — повтор ловится базой,
//     а не только приложением;
//   • отмена операции — новая запись REVERSAL со ссылкой reversalOfId,
//     исходная строка не правится никогда.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"

  // apps/api — CommonJS (NestJS 10 держится на legacy-декораторах).
  // Prisma 7 по умолчанию генерирует ESM, поэтому формат задан явно.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7 больше не принимает url в блоке datasource: строка подключения живёт
// в prisma.config.ts (для CLI) и в driver adapter (для рантайма клиента).
datasource db {
  provider = "postgresql"
}

// ─── Перечисления ────────────────────────────────────────────────────────────

enum Vertical {
  RESTAURANT
  SPA
  RENTAL
  RETAIL
  OTHER
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAUSED
  CHURNED
}

enum Plan {
  FREE
  PRO
  NETWORK
}

enum GuestMode {
  TOURIST
  RESIDENT
}

enum AcquisitionSource {
  ORGANIC
  CATALOG
  REFERRAL
  STAFF
  IMPORT
}

/// Тип ledger-записи. Знак amount задаётся типом операции, а не полем:
/// EARN/GRANT/ADJUST(+) кладут плюс, REDEEM/EXPIRE — минус,
/// REVERSAL — противоположный знак отменяемой записи.
enum LedgerType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  REVERSAL
  GRANT
}

/// Откуда пришла операция. Нужен антифроду: STAFF_MANUAL и SIGNED_QR
/// имеют принципиально разный уровень доверия.
enum LedgerSource {
  POS_WEBHOOK
  POS_SYNC
  SIGNED_QR
  STAFF_MANUAL
  PAYMENT
  SYSTEM
}

enum ActorType {
  SYSTEM
  STAFF
  OWNER
  GUEST
}

// ─── Модели ──────────────────────────────────────────────────────────────────

/// Мерчант. Корень мультитенантности: всё тенантное ссылается сюда,
/// RLS-политики в Задаче 3 будут сравнивать tenantId с app.tenant_id.
model Tenant {
  id         String       @id @default(uuid())
  brandName  String
  legalName  String?
  vertical   Vertical
  currency   String       @default("THB")
  timezone   String       @default("Asia/Bangkok")
  locale     String       @default("th")
  status     TenantStatus @default(TRIAL)
  plan       Plan         @default(FREE)
  seasonMode Boolean      @default(false) // льготный тариф низкого сезона
  settings   Json // ProgramConfig, docs/01 раздел 4.3
  createdAt  DateTime     @default(now())

  memberships       Membership[]
  ledgerEntries     LedgerEntry[]
  staff             Staff[]
  staffDevices      StaffDevice[]
  sessions          Session[]
  previews          TransactionPreview[]
  posLinks          PosLink[]
  webhookEvents     WebhookEvent[]
  webhookDeliveries WebhookDelivery[]
}

/// Гость платформы. Один на всю сеть мерчантов: телефон — сквозной идентификатор,
/// участие в конкретной программе описывает Membership.
model Guest {
  id           String    @id @default(uuid())
  phoneE164    String    @unique // первичный идентификатор
  displayName  String?
  locale       String    @default("ru") // ru | en | th | zh
  mode         GuestMode @default(TOURIST) // вычисляемое по поведению
  modeLockedBy String? // 'auto' | 'manual'
  birthday     DateTime? // спрашиваем позже, не на входе
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?

  memberships   Membership[]
  guestSessions GuestSession[]
  ledgerEntries LedgerEntry[]
}

/// Участие гостя в программе конкретного тенанта.
///
/// pointsBalance — денормализованный КЭШ. Источник истины — сумма LedgerEntry.amount.
/// Пишется только внутри той же Serializable-транзакции, что и ledger-запись,
/// и только из LedgerService. Ночной джоб reconcile сверяет кэш с суммой.
model Membership {
  id             String            @id @default(uuid())
  guestId        String
  tenantId       String
  pointsBalance  Int               @default(0) // КЭШ. Источник истины — ledger
  stampsCount    Int               @default(0)
  tierId         String? // id статуса из Tenant.settings.tiers, не FK
  firstVisitAt   DateTime?
  lastVisitAt    DateTime?
  visitsTotal    Int               @default(0)
  spentTotal     Int               @default(0) // в минорных единицах (сатанги)
  source         AcquisitionSource @default(ORGANIC)
  referredById   String? // Membership, приведший этого гостя; FK появится вместе с рефералкой
  isControlGroup Boolean           @default(false) // 5% без начислений — доказательство ROI

  guest         Guest                @relation(fields: [guestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ledgerEntries LedgerEntry[]
  previews      TransactionPreview[]

  @@unique([guestId, tenantId])
  // Под политику RLS на Guest: она делает EXISTS по участиям на каждую строку.
  // Индекс создан миграцией 20260826120000_tenant_isolation_rls; объявлен здесь,
  // иначе следующий diff посчитал бы его лишним и удалил — тихая деградация
  // в последовательный скан на каждом чтении гостя.
  @@index([guestId, tenantId])
  @@index([tenantId, lastVisitAt])
}

/// Журнал операций с баллами. Append-only: единственная разрешённая операция — INSERT.
///
/// Запрет UPDATE/DELETE живёт в миграции и продублирован двумя независимыми
/// механизмами (REVOKE + BEFORE-триггер), потому что каждый по отдельности обходится.
/// Подробности — в prisma/README.md и в комментариях migration.sql.
model LedgerEntry {
  id           String @id @default(uuid())
  tenantId     String
  guestId      String
  membershipId String

  type         LedgerType
  amount       Int // ЗНАКОВОЕ: +начисление, −списание. Баллы целые.
  balanceAfter Int // снапшот для быстрых выписок

  basisAmount Int? // сумма чека в минорных единицах (сатанги)
  currency    String @default("THB")

  source  LedgerSource
  refType String? // receipt | offer_grant | referral | promo
  refId   String?

  /// Ключ идемпотентности. UNIQUE — последний рубеж: даже если приложение
  /// проспит гонку, вторую запись не пустит база.
  idempotencyKey String  @unique
  /// Ссылка на отменяемую запись. UNIQUE — одну операцию нельзя отменить дважды.
  reversalOfId   String? @unique
  offerId        String? // Offer появится в Задаче по акциям, пока не FK

  actorType  ActorType
  actorId    String?
  locationId String? // Location появится позже, пока не FK
  deviceId   String?
  ip         String?

  /// Когда мы об операции УЗНАЛИ.
  createdAt DateTime @default(now())

  /// Когда операция ПРОИЗОШЛА, если это не момент записи. NULL — совпадает.
  ///
  /// Чек от кассы приходит вебхуком, и вебхук опаздывает: связь рвётся, касса
  /// работает офлайн и досылает смену вечером. Без этого поля вечерняя выгрузка
  /// легла бы одним столбцом отчёта, а «загрузка по часам» показала бы девять
  /// вечера вместо обеда — и владелец поставил бы акцию не на тот час.
  ///
  /// Аналитика читает coalesce(occurredAt, createdAt); createdAt при этом
  /// остаётся неизменяемым и отвечает на другой вопрос — когда узнали.
  occurredAt DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  guest      Guest      @relation(fields: [guestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Самоссылка «отмена → исходная операция».
  // Restrict с обеих сторон: SetNull по умолчанию означал бы UPDATE строки ledger,
  // а UPDATE на этой таблице запрещён триггером — FK просто перестал бы работать.
  reversalOf LedgerEntry? @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy LedgerEntry? @relation("LedgerReversal")

  @@index([tenantId, createdAt])
  // Аналитика группирует по времени СОБЫТИЯ, а не записи: без этого индекса
  // дашборд заведения за 90 дней уходит в последовательный скан журнала.
  @@index([tenantId, occurredAt])
  @@index([membershipId, createdAt])
  @@index([guestId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Аутентификация и роли
// docs/05_Безопасность_и_антифрод.md, разделы 2 и 3
// ─────────────────────────────────────────────────────────────────────────────

/// Роли из docs/05, раздел 3. Матрица прав — там же.
enum Role {
  CASHIER
  MANAGER
  OWNER
  /// Отдельный контур: свой поддомен, IP-allowlist, обязательная 2FA.
  PLATFORM_ADMIN
}

/// Сотрудник заведения.
///
/// Владелец входит через OAuth POSitive POS и в этой таблице появляется без PIN.
/// Кассир и менеджер входят по PIN, и ТОЛЬКО с зарегистрированного устройства.
model Staff {
  id       String @id @default(uuid())
  tenantId String
  role     Role   @default(CASHIER)

  displayName String
  /// PII. В логи не попадает, наружу отдаётся маскированным.
  phoneE164   String?

  /// PIN не хранится. Здесь производная scrypt вместе с солью и параметрами.
  /// null у владельца: он входит не по PIN.
  pinHash           String?
  /// Сколько неверных PIN подряд. Сбрасывается успешным входом.
  pinFailedAttempts Int       @default(0)
  /// До какого момента вход заблокирован после серии неудач.
  pinLockedUntil    DateTime?

  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  devices  StaffDevice[]
  sessions Session[]

  @@index([tenantId, role])
}

/// Устройство, с которого сотруднику разрешено входить.
///
/// Регистрирует владелец. Без записи здесь PIN не принимается: иначе кассир
/// заходит с домашнего телефона и начисляет себе ночью (docs/05, раздел 2).
model StaffDevice {
  id       String @id @default(uuid())
  tenantId String
  staffId  String

  /// Отпечаток устройства, приходит от клиента кассы. Уникален глобально:
  /// одно физическое устройство не должно числиться за двумя заведениями.
  deviceId String @unique
  /// Человекочитаемая метка для списка в бэк-офисе: «Планшет у бара».
  label    String

  isActive     Boolean   @default(true)
  registeredAt DateTime  @default(now())
  /// Кто зарегистрировал. Нужен аудиту.
  registeredBy String?
  revokedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, staffId])
}

/// Сессия: одно звено цепочки refresh-токенов.
///
/// Каждое обновление выдаёт новый refresh и инвалидирует старый (ротация).
/// Повторное использование отозванного — сигнал кражи: отзывается ВСЯ цепочка
/// (`familyId`), а не только это звено (docs/05, раздел 2).
model Session {
  id       String @id @default(uuid())
  tenantId String

  /// Кто владеет сессией. Гость появится вместе с OTP-входом.
  staffId String?

  /// Цепочка ротаций. Общий для всех звеньев одного входа.
  familyId String
  /// Предыдущее звено. Позволяет восстановить порядок при разборе инцидента.
  parentId String? @unique

  /// Сам токен не хранится — только SHA-256 от него.
  /// Refresh высокоэнтропийный и случайный, поэтому медленный KDF здесь не нужен:
  /// перебор невозможен, а быстрый хеш не даёт сравнивать за разное время.
  refreshTokenHash String @unique

  /// Привязка к устройству: refresh с чужого устройства не принимается.
  deviceId String?

  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  /// TOKEN_ROTATED | TOKEN_REUSED | LOGOUT | DEVICE_REVOKED | STAFF_DISABLED
  revokedReason String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, familyId])
  @@index([staffId, issuedAt])
}

/// Предрасчёт кассы: что произойдёт, если чек провести.
///
/// ПОЧЕМУ ТАБЛИЦА, А НЕ REDIS. Redis в проекте будет (Upstash, docs/01 раздел 6),
/// но предрасчёт — это финансовое намерение: по нему через минуту спишут баллы.
/// Потеря записи при перезапуске кеша означает «касса нажала подтвердить,
/// а система забыла, что обещала». В Postgres он живёт вместе с журналом,
/// попадает под ту же изоляцию и переживает всё, что переживает журнал.
///
/// Живёт 10 минут (docs/02, раздел 3.3: PREVIEW_EXPIRED). Чистится фоновой
/// задачей, когда появится воркер с очередями.
model TransactionPreview {
  id       String @id @default(uuid())
  tenantId String

  membershipId String
  guestId      String

  /// Сумма чека в минорных единицах.
  amount          Int
  /// Сколько баллов гость просит списать.
  redeemRequested Int @default(0)
  /// Сколько списать можно на самом деле: минимум из запроса, баланса и потолка.
  redeem          Int
  /// Сколько начислится после списания.
  pointsToEarn    Int
  /// К оплате деньгами после списания баллов.
  amountToPay     Int

  /// Баланс на момент расчёта. Расхождение при коммите — BALANCE_CHANGED.
  balanceAtPreview Int

  receiptNumber String?
  locationId    String?
  /// Кто считал. Нужен и аудиту, и будущей награде сотруднику.
  staffId       String?

  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  /// Заполняется при коммите: повторное проведение того же предрасчёта запрещено.
  committedAt DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, expiresAt])
  @@index([membershipId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Интеграция с POSitive POS
// docs/01, раздел 3 · docs/02, раздел 4
// ─────────────────────────────────────────────────────────────────────────────

/// Связь заведения с его же заведением в кассовой системе.
///
/// Заполняется один раз при подключении. Пока POS не умеет отдавать OAuth,
/// связь заводится вручную (docs/01, раздел 3.1) — на схеме это не сказывается.
model PosLink {
  id String @id @default(uuid())

  tenantId String

  /// Идентификатор заведения в POSitive POS. UNIQUE глобально: одно заведение
  /// кассы принадлежит ровно одному заведению лояльности, иначе непонятно,
  /// кому начислять.
  posMerchantId String  @unique
  /// Точка, если их несколько.
  posLocationId String?

  /// Куда слать наши события. NULL — касса их не принимает, и мы не шлём.
  ///
  /// Адрес приходит от кассы при подключении. Пока его нет, исходящие события
  /// просто не создаются: копить недоставляемое в очереди бессмысленно.
  callbackUrl String?

  /// Ключ HMAC для проверки подписи входящих вебхуков.
  ///
  /// Лежит в открытом виде намеренно: им нужно ВЫЧИСЛЯТЬ подпись, а не сверять
  /// хеш, поэтому односторонняя функция здесь не подходит. Шифрование строки
  /// в базе появится вместе с хранилищем ключей; до тех пор доступ к колонке
  /// закрыт теми же политиками RLS, что и всё остальное тенантное.
  webhookSecret String

  isActive  Boolean   @default(true)
  linkedAt  DateTime  @default(now())
  revokedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
}

/// Состояние входящего события.
enum WebhookStatus {
  /// Принято и лежит в очереди. Именно эта строка и есть очередь.
  PENDING
  /// Обработано: баллы начислены либо осознанно не начислены.
  PROCESSED
  /// Обработать не удалось; причина в lastError, разбирает человек.
  FAILED
  /// Событие корректное, но делать по нему нечего — например, чек без гостя.
  SKIPPED
}

/// Входящее событие от кассы. Одновременно журнал приёма и очередь обработки.
///
/// ПОЧЕМУ ЭТО ОЧЕРЕДЬ, А НЕ ЗАПИСЬ РЯДОМ С ОЧЕРЕДЬЮ. ТЗ требует принять
/// событие, ответить за 200 мс и обработать асинхронно. Если писать строку
/// сюда И класть задачу в Redis, появляются два независимых хранилища и две
/// новые поломки: строка без задачи — событие принято и потеряно; задача без
/// строки — дедупликация не сработала и чек начислен дважды. Приём должен быть
/// ОДНОЙ транзакцией, поэтому очередь и журнал — одна таблица.
model WebhookEvent {
  id String @id @default(uuid())

  tenantId String

  /// Откуда пришло. Пока единственный источник — POSitive POS.
  source    String
  /// receipt.closed | receipt.voided
  eventType String

  /// `X-Idempotency-Key` отправителя.
  ///
  /// Уникален В ПРЕДЕЛАХ ЗАВЕДЕНИЯ, а не глобально, — и это отступление
  /// от формулировки docs/01, раздел 9. Глобальный UNIQUE на идентификаторе,
  /// который придумывает чужая сторона, означает: одно заведение может занять
  /// чужой номер чека и заблокировать соседу приём. Номера чеков у разных касс
  /// совпадают сплошь и рядом.
  externalId String

  /// Тело события целиком. Нужно для разбора инцидентов и повторной обработки.
  payload Json

  status    WebhookStatus @default(PENDING)
  attempts  Int           @default(0)
  /// Причина последней неудачи. PII сюда не пишется.
  lastError String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, externalId])
  @@index([tenantId, receivedAt])
  /// Под выборку необработанных: восстановление после падения идёт по ней.
  @@index([status, receivedAt])
}

/// Состояние исходящей доставки.
enum DeliveryStatus {
  /// Ждёт отправки или следующей попытки.
  PENDING
  /// Касса ответила 2xx.
  DELIVERED
  /// Попытки исчерпаны. Разбирает человек.
  FAILED
}

/// Исходящее событие к кассе. Исходящий журнал (outbox).
///
/// СОБЫТИЕ ВЫВОДИТСЯ ИЗ ЖУРНАЛА, А НЕ ПИШЕТСЯ РЯДОМ С НИМ. Это главное решение
/// таблицы, и оно не про удобство.
///
/// Очевидный ход — писать строку сюда в той же транзакции, что и операцию.
/// Он даёт нужную гарантию, но требует, чтобы `LedgerService` знал про кассу:
/// где взять адрес, какой ключ, слать ли вообще. Ядро начало бы зависеть
/// от прикладного модуля, а такую зависимость потом не разорвать.
///
/// Journal уже append-only и долговечен. Поэтому разгребатель сам находит
/// операции, о которых касса ещё не знает, и заводит им доставку. Гарантия
/// ровно та же — операция есть, значит и событие о ней появится, — а ядро
/// не трогается вовсе. Цена: событие уходит не мгновенно, а в ближайший
/// проход. Для «касса показывает свежий баланс» это приемлемо.
///
/// Событие может уйти дважды, и это нормально: `eventId` в теле нужен затем,
/// чтобы касса дедуплицировала у себя. «Ровно один раз» через сеть
/// не гарантируется в принципе.
model WebhookDelivery {
  id String @id @default(uuid())

  tenantId String

  /// Операция журнала, о которой сообщаем.
  ///
  /// UNIQUE — здесь работает вместо ключа идемпотентности: два прохода
  /// разгребателя, столкнувшись на одной операции, не заведут две доставки.
  /// Вторая вставка упрётся в базу, а не в удачу.
  ledgerEntryId String @unique

  /// guest.balance_changed | offer.granted
  eventType String
  /// Тело события целиком, уже готовое к отправке.
  payload   Json

  /// Куда слали. Снимок на момент постановки: адрес мог смениться, а событие
  /// принадлежит тому подключению, при котором возникло.
  targetUrl String

  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  /// Когда пробовать следующий раз. Пауза растёт: 1с, 5с, 30с, 5м, 30м.
  nextAttemptAt DateTime       @default(now())
  /// Причина последней неудачи. PII сюда не пишется.
  lastError     String?

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Под выборку «что пора отправить».
  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Гостевой доступ: OTP и сессии гостя
// docs/02, разделы 1.1–1.2 · docs/05, раздел 2
//
// Обе таблицы ГЛОБАЛЬНЫЕ — без tenantId, как и сам Guest: гость один на весь
// остров, его вход не принадлежит заведению. Изоляция здесь другая, чем у
// тенантных таблиц: строки адресуются только секретом (хеш кода, хеш refresh),
// знание которого само по себе и есть право доступа. Подробности — в миграции.
// ─────────────────────────────────────────────────────────────────────────────

/// Запрос кода подтверждения.
model OtpRequest {
  id String @id @default(uuid())

  /// PII. В логи не попадает, маскируется на выводе.
  phoneE164 String

  /// Сам код не хранится — только производная scrypt с солью.
  codeHash String

  /// Куда ушёл код. Пока единственный канал DEV: без SMS-провайдера код
  /// печатается в лог сервера (и отдаётся в ответе вне production).
  channel String @default("DEV")

  /// Неверные попытки. После пятой запрос блокируется (docs/02, раздел 1.2).
  attempts Int @default(0)

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  verifiedAt DateTime?

  @@index([phoneE164, createdAt])
}

/// Сессия гостя: звено цепочки refresh-токенов. Устройство ротации то же,
/// что у сотрудников (Session): повтор отозванного звена гасит всю цепочку.
model GuestSession {
  id      String @id @default(uuid())
  guestId String

  familyId String
  parentId String? @unique

  /// Хеш refresh-токена. Быстрый SHA-256: токен высокоэнтропийный, KDF не нужен.
  refreshTokenHash String @unique

  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  revokedReason String?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([guestId, familyId])
}
