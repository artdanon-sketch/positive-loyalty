# ─────────────────────────────────────────────────────────────────────────────
# apps/api — переменные окружения.
# Скопируй в apps/api/.env и подставь свои значения.
#
# Это подмножество корневого .env.example: тут только то, что реально читает
# apps/api/src/common/config/env.ts. Всё, чего нет в схеме, приложение игнорирует.
#
# Реальные секреты в репозиторий не попадают никогда — они живут в Railway env
# и Supabase Vault (docs/05_Безопасность_и_антифрод.md, раздел 9).
# ─────────────────────────────────────────────────────────────────────────────

# Режим работы: development | test | production
NODE_ENV=development

# Порт HTTP-сервера. Локально фронты ждут API именно здесь.
PORT=3000

# PostgreSQL. Локально — docker postgres, в облаке — Supabase.
# Формат: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Пример:  postgresql://positive_app:ЗАМЕНИ_МЕНЯ@localhost:5432/positive_loyalty?schema=public
#
# Читают двое: Prisma CLI (через prisma.config.ts в корне репозитория — миграции,
# generate, studio) и driver adapter @prisma/adapter-pg внутри приложения.
# Prisma 7 подключается только через адаптер, поэтому строка нужна процессу API,
# а не только консольным командам.
#
# Значения по умолчанию нет намеренно: молчаливый фолбэк на localhost однажды
# закончится миграцией, накатанной не на ту базу.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/positive_loyalty?schema=public

# Список origin через запятую — кому браузер разрешает ходить в API.
# В production переменная ОБЯЗАТЕЛЬНА: без неё приложение не стартует,
# подставлять localhost по умолчанию в проде нельзя.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Версия сборки, её отдаёт GET /health. В облаке подставляется при деплое.
APP_VERSION=0.0.0

# ── Способы входа гостя ──────────────────────────────────────────────────────
#
# Обе переменные необязательны. Пусто — соответствующий способ входа выключен
# целиком, и приложение не рисует кнопку: сервер сообщает о своих возможностях
# в GET /health, и кнопка без серверной половины не появляется.

# Идентификатор приложения в Google. СЕКРЕТОМ НЕ ЯВЛЯЕТСЯ — он и так виден
# в коде страницы. Нужен серверу, чтобы сверить, кому выписан токен: без него
# подошёл бы токен Google, выданный любому другому сайту.
# Та же строка должна попасть в сборку фронта как VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Ключ бота Telegram от @BotFather. ЭТО НАСТОЯЩИЙ СЕКРЕТ: кто им владеет,
# читает переписку бота и пишет от его имени. В репозиторий не попадает,
# живёт в Railway env.
# Формат: <число>:<строка>. Опечатка роняет процесс на старте — намеренно.
TELEGRAM_BOT_TOKEN=

# Адрес приложения гостя — тот, что открывается в браузере и внутри Telegram.
# Нужен серверу для двух кнопок: «Моя карта» у бота и «Открыть карту» под
# сообщением рассылки. Только https: Telegram другого не откроет.
# Пусто — бот работает по-прежнему, просто без кнопок.
GUEST_APP_URL=

# Ключи уведомлений в приложении гостя (Web Push). Создаются один раз
# командой `pnpm push:keys`.
#
# VAPID_PUBLIC_KEY секретом НЕ является: он уезжает в браузер гостя при подписке.
# VAPID_PRIVATE_KEY — настоящий секрет: кто им владеет, шлёт уведомления нашим
# гостям от нашего имени. В репозиторий не попадает, живёт в Railway env.
# VAPID_SUBJECT — адрес для связи (mailto: или https), требование протокола.
#
# Пусто — уведомления выключены целиком, рассылки идут только в Telegram.
# Менять пару ключей нельзя без последствий: все выданные подписки перестают
# работать молча.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
