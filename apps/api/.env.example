# ─────────────────────────────────────────────────────────────────────────────
# apps/api — переменные окружения.
# Скопируй в apps/api/.env и подставь свои значения.
#
# Это подмножество корневого .env.example: тут только то, что реально читает
# apps/api/src/common/config/env.ts. Всё, чего нет в схеме, приложение игнорирует.
#
# Реальные секреты в репозиторий не попадают никогда — они живут в Railway env
# и Supabase Vault (docs/05_Безопасность_и_антифрод.md, раздел 9).
# ─────────────────────────────────────────────────────────────────────────────

# Режим работы: development | test | production
NODE_ENV=development

# Порт HTTP-сервера. Локально фронты ждут API именно здесь.
PORT=3000

# Список origin через запятую — кому браузер разрешает ходить в API.
# В production переменная ОБЯЗАТЕЛЬНА: без неё приложение не стартует,
# подставлять localhost по умолчанию в проде нельзя.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Версия сборки, её отдаёт GET /health. В облаке подставляется при деплое.
APP_VERSION=0.0.0
