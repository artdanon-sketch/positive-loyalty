# apps/admin — переменные сборки бэк-офиса.
# Vite отдаёт в бандл только переменные с префиксом VITE_: значение видно в исходниках
# страницы, поэтому секретам здесь не место (docs/05_Безопасность_и_антифрод.md, раздел 9).

# Базовый URL API вместе с версией пути.
VITE_API_URL=http://localhost:3000/v1

# Приложение гостя: сюда ведут ссылки источников трафика. Не задан — боевой адрес
# https://positive-guest.pages.dev.
VITE_GUEST_URL=http://localhost:5174
