{
  // Конфиг самодостаточный: приложение — лист монорепо, общие пресеты ему нечего наследовать
  // кроме строгости, а строгость дешевле держать на виду, чем искать в трёх файлах.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,

    // strict — обязателен по CLAUDE.md, остальное добивает дыры, через которые обычно
    // просачивается undefined.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "vitest.setup.ts"]
}
