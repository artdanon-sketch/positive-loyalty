# ─────────────────────────────────────────────────────────────────────────────
# apps/worker — переменные окружения.
#
# Это подмножество корневого .env.example: тут только то, что реально читает
# apps/worker/src/config.ts. Всё, чего нет в схеме, воркер игнорирует.
#
# Локально отдельный файл заводить не нужно: `pnpm dev:worker` подгружает
# КОРНЕВОЙ .env (node --env-file-if-exists=../../.env). Достаточно один раз
# сделать `cp .env.example .env` в корне репозитория. Если корневого .env нет,
# команда не падает на старте — воркер упадёт позже, на разборе конфигурации,
# потому что REDIS_URL обязателен.
#
# В облаке (Railway) файл не используется вовсе: переменные приходят из env
# сервиса. Реальные секреты в репозиторий не попадают никогда — они живут
# в Railway env и Supabase Vault (docs/05_Безопасность_и_антифрод.md, раздел 9).
# ─────────────────────────────────────────────────────────────────────────────

# Режим работы: development | test | production
# Необязательна. По умолчанию: development
NODE_ENV=development

# Уровень логирования: debug | info | warn | error
# Необязательна. По умолчанию: info
LOG_LEVEL=info

# ОБЯЗАТЕЛЬНА. Без неё воркер не стартует: WorkerConfigError на разборе конфига.
# Redis для очередей BullMQ. Локально — docker, в облаке — Upstash.
# Формат: redis://[<user>:<password>@]<host>[:<port>][/<db>]
# Для Upstash и любого облачного Redis схема rediss:// — соединение по TLS.
# Порт необязателен, по умолчанию 6379.
REDIS_URL=redis://localhost:6379

# Сколько задач воркер берёт параллельно.
# Целое число, от 1 до 64. Необязательна. По умолчанию: 5
WORKER_CONCURRENCY=5

# Сколько миллисекунд ждём завершения текущих задач по SIGTERM,
# прежде чем выйти принудительно.
# Целое число, от 1000 до 120000. Необязательна. По умолчанию: 15000
WORKER_SHUTDOWN_TIMEOUT_MS=15000
